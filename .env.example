# Runtime Ports
PORT=3000
API_PORT=4000
WEB_PORT=3001

# Runtime & Security
NODE_ENV=production
COOKIE_SECURE=false
JWT_SECRET=change-this-super-secret-jwt-key-in-psm
JWT_EXPIRES_IN=7d

# Database (PSM auto-provisions PostgreSQL and overrides DATABASE_URL)
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://fadb:wokeh123@postgres:5432/archflow?schema=public

# Frontend (same-origin reverse proxy in Docker/PSM)
NEXT_PUBLIC_API_URL=/api
